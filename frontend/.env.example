# ════════════════════════════════════════════════════════
# Amazon Now — Frontend Environment Variables
# Copy to .env.local for dev, set in Amplify/EC2 for production
# ════════════════════════════════════════════════════════

# Backend API URL — leave UNSET locally (auto-detected from window.location.hostname)
# Set for production:
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_API_URL=http://your-ec2-ip:8000

# Backend port — used when NEXT_PUBLIC_API_URL is not set (default: 8000)
# NEXT_PUBLIC_BACKEND_PORT=8000

# Demo user ID — maps to DynamoDB user record
# Change per user in production
# NEXT_PUBLIC_USER_ID=u001
