# ── LLM Provider ─────────────────────────────────────────────────────────────
# Supported: openrouter | github | openai | ollama | groq | together
LLM_PROVIDER=openrouter

# OpenRouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-...
LLM_MODEL=anthropic/claude-3.5-haiku

# GitHub Models (swap base_url + key, keep same provider value "github")
# LLM_PROVIDER=github
# LLM_BASE_URL=https://models.inference.ai.azure.com
# LLM_API_KEY=ghp_...
# LLM_MODEL=gpt-4o-mini

# Local Ollama
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# Optional: faster/cheaper model for lightweight tasks
LLM_SMALL_MODEL=anthropic/claude-3-haiku

# ── Embeddings (OpenAI-compatible) ───────────────────────────────────────────
# Works with: OpenAI, Ollama, LM Studio, local servers, etc.
# Example with OpenAI:
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Example with Ollama (local):
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# Example with LM Studio (local):
# EMBEDDING_PROVIDER=lmstudio
# EMBEDDING_BASE_URL=http://localhost:1234/v1
# EMBEDDING_API_KEY=lmstudio
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# ── Gemini Live API (for Ramble voice) ───────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# ── Voice Shopping (AWS) ──────────────────────────────────────────────────────
# Set USE_MOCK=true for local dev (no real AWS calls)
USE_MOCK_TRANSCRIBE=true
USE_MOCK_BEDROCK=true
TRANSCRIBE_LANGUAGE_CODE=en-IN
TRANSCRIBE_SAMPLE_RATE=16000
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
