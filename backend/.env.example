# ════════════════════════════════════════════════════════
# Amazon Now — Backend Environment Variables
# Copy this to .env and fill in your values
# ════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production            # development | production
APP_PORT=8000
# Comma-separated allowed origins. Use * for open (dev) or your domain for prod
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── DynamoDB ──────────────────────────────────────────────────────────────────
# Local dev:   DYNAMODB_ENDPOINT=http://localhost:8001, ACCESS_KEY=local
# AWS EC2/ECS: Leave DYNAMODB_ENDPOINT empty → uses real AWS. Leave creds empty to use IAM role.
DYNAMODB_ENDPOINT=            # empty = real AWS DynamoDB
DYNAMODB_REGION=ap-south-1
DYNAMODB_ACCESS_KEY=          # leave empty to use IAM instance role
DYNAMODB_SECRET_KEY=

# ── LLM (for assistant features) ─────────────────────────────────────────────
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_key
LLM_MODEL=anthropic/claude-3.5-haiku

# ── Embeddings ────────────────────────────────────────────────────────────────
# Swap model here without changing code:
# OpenAI:  PROVIDER=openai, BASE_URL=https://api.openai.com/v1, MODEL=text-embedding-3-small, DIMS=1536
# Ollama:  PROVIDER=ollama, BASE_URL=http://localhost:11434/v1, MODEL=mxbai-embed-large, DIMS=1024
# Cohere:  PROVIDER=cohere, BASE_URL=https://api.cohere.ai/v1, MODEL=embed-english-v3.0, DIMS=1024
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your_openai_key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Voice Provider ────────────────────────────────────────────────────────────
# gemini → Google Gemini Live (audio + vision scan)
# nova_sonic → Amazon Nova Sonic via Bedrock (audio only)
VOICE_PROVIDER=gemini

# ── Gemini Live API ───────────────────────────────────────────────────────────
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-live-preview

# ── Amazon Nova Sonic ─────────────────────────────────────────────────────────
# Enable in AWS Console: Bedrock → Model access → Nova Sonic
# On EC2/ECS with IAM role, leave creds empty
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
NOVA_SONIC_MODEL=amazon.nova-sonic-v1:0

# ── Catalog Enrichment (run ONCE offline — not needed at runtime) ─────────────
# uv run python -m app.db.enrich_catalog --workers 10 --resume
ENRICH_API_KEY=your_mistral_key
ENRICH_BASE_URL=https://api.mistral.ai/v1
ENRICH_MODEL=open-mistral-nemo
