# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8000

# ── DynamoDB (local dev) ─────────────────────────────────────────────────────
DYNAMODB_ENDPOINT=http://localhost:8001
DYNAMODB_REGION=ap-south-1
DYNAMODB_ACCESS_KEY=local
DYNAMODB_SECRET_KEY=local

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_openrouter_key_here
LLM_MODEL=anthropic/claude-3.5-haiku

# ── Embeddings ────────────────────────────────────────────────────────────────
# Local Ollama (recommended — pull mxbai-embed-large first):
#   ollama pull mxbai-embed-large
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIMENSIONS=1024

# ── Voice Provider ─────────────────────────────────────────────────────────────
# "gemini"     → Google Gemini Live API (works now, has quota limits)
# "nova_sonic" → Amazon Nova Sonic via Bedrock (swap when AWS creds ready)
VOICE_PROVIDER=gemini

# ── Gemini Live API ────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-live-preview

# ── Amazon Nova Sonic (Bedrock) ────────────────────────────────────────────────
# Enable model access in AWS Console → Bedrock → Model access → Nova Sonic
# Region: ap-south-1 (Mumbai) recommended for India
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1
NOVA_SONIC_MODEL=amazon.nova-sonic-v1:0

# ── Catalog Enrichment LLM ─────────────────────────────────────────────────────
# Used by: uv run python -m app.db.enrich_catalog
# Get a free Mistral API key at: https://console.mistral.ai
ENRICH_API_KEY=your_mistral_api_key_here
ENRICH_BASE_URL=https://api.mistral.ai/v1
ENRICH_MODEL=open-mistral-nemo
